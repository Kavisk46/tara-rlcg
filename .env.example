# Copy this file to .env and adjust as needed. All variables are optional;
# every setting has a sensible default (see src/tara/core/config.py).

# --- Repository parsing ---
TARA_MAX_FILE_SIZE_BYTES=1000000
TARA_IGNORED_DIRECTORIES=[]

# --- Repository context / dense retrieval ---
TARA_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
TARA_EMBEDDING_DEVICE=cpu
TARA_FAISS_INDEX_PATH=.tara/faiss.index

# --- Task classification ---
TARA_TASK_CLASSIFIER_MODEL_NAME=microsoft/codebert-base

# --- Code generation ---
TARA_LLM_MODEL_NAME=gpt-4o-mini

# --- Service ---
TARA_LOG_LEVEL=INFO
TARA_API_HOST=0.0.0.0
TARA_API_PORT=8000
