# Copy this file to .env to override OracleUtilityComputer defaults.
# Every variable is optional; all settings have sensible defaults
# (see evaluation/rts_builder/oracle_utility/config.py).

# k for Recall@k and NDCG@k. Context precision is NOT truncated by this.
RTS_ORACLE_QUALITY_METRICS_K=10

# Composite Quality weights -- must sum to 1.0.
RTS_ORACLE_QUALITY_RECALL_WEIGHT=0.25
RTS_ORACLE_QUALITY_MRR_WEIGHT=0.25
RTS_ORACLE_QUALITY_NDCG_WEIGHT=0.25
RTS_ORACLE_QUALITY_CONTEXT_PRECISION_WEIGHT=0.25

# Utility = alpha*Quality - beta*Latency_normalized.
# alpha must be > 0. beta must be >= 0 (0 disables the latency penalty).
# beta's default (0.1) mirrors docs/DATASET_BUILDER_SPEC.md's lambda=0.1
# proposed default -- NOT a validated constant; see Oracle_Math.md.
RTS_ORACLE_UTILITY_QUALITY_WEIGHT=1.0
RTS_ORACLE_UTILITY_LATENCY_WEIGHT=0.1

# Two strategies are tied if |Utility(a) - Utility(b)| < tie_epsilon.
# Proposed default per docs/DATASET_BUILDER_SPEC.md, pilot-calibrated, not fixed in advance.
RTS_ORACLE_TIE_EPSILON=0.02

# epsilon_0 in the label_confidence formula; prevents division by zero
# when the top-ranked strategy's utility is itself near zero.
RTS_ORACLE_CONFIDENCE_EPSILON=0.000001
