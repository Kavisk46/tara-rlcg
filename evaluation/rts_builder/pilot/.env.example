# Copy this file to .env to override PilotRunner defaults. Every
# variable is optional; all settings have sensible defaults
# (see evaluation/rts_builder/pilot/config.py).

# Directory every pilot dataset/report/figure artifact is written under.
RTS_PILOT_DATA_DIR=data
RTS_PILOT_FIGURES_DIRNAME=figures

# Must sum to 1.0 (validated at construction).
RTS_PILOT_TRAIN_RATIO=0.70
RTS_PILOT_VALIDATION_RATIO=0.15
RTS_PILOT_TEST_RATIO=0.15
# Salt for the deterministic per-query split hash -- keep fixed across a pilot's lifetime.
RTS_PILOT_SPLIT_SEED=tara-rts-pilot-v1

RTS_PILOT_TRAIN_PARQUET_FILENAME=train.parquet
RTS_PILOT_VALIDATION_PARQUET_FILENAME=validation.parquet
RTS_PILOT_TEST_PARQUET_FILENAME=test.parquet
RTS_PILOT_TRAIN_JSONL_FILENAME=train.jsonl
RTS_PILOT_VALIDATION_JSONL_FILENAME=validation.jsonl
RTS_PILOT_TEST_JSONL_FILENAME=test.jsonl

RTS_PILOT_DATASET_STATISTICS_FILENAME=dataset_statistics.json
RTS_PILOT_FEATURE_STATISTICS_FILENAME=feature_statistics.csv
RTS_PILOT_VALIDATION_REPORT_FILENAME=validation_report.md
RTS_PILOT_DATASET_README_FILENAME=README.md
RTS_PILOT_DATASET_CARD_FILENAME=DATASET_CARD.md

# How many strategy rows a query must have for "every query has exactly four strategy rows".
RTS_PILOT_EXPECTED_STRATEGY_COUNT=4
RTS_PILOT_HISTOGRAM_BIN_COUNT=10
# If true (default), a failed blocking Success Criterion raises PilotValidationError and no
# split/figure/doc files are written. If false, the run proceeds anyway -- useful for debugging.
RTS_PILOT_FAIL_ON_VALIDATION_ERROR=true

RTS_PILOT_FIGURE_DPI=150
