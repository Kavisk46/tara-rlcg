# Copy this file to .env to override FeatureExtractor defaults. Every
# variable is optional; all settings have sensible defaults
# (see evaluation/rts_builder/feature_extraction/config.py).

# Approximate characters-per-token ratio used to estimate repository
# token count from total source size (no LLM tokenizer dependency).
RTS_FEATURES_CHARS_PER_TOKEN_ESTIMATE=4.0

# Repositories with at most this many files are categorized 'small'.
RTS_FEATURES_SMALL_REPOSITORY_FILE_COUNT_THRESHOLD=50

# Repositories with more than this many files are categorized 'large';
# in between is 'medium'.
RTS_FEATURES_LARGE_REPOSITORY_FILE_COUNT_THRESHOLD=500

# query_complexity weights -- must sum to 1.0.
RTS_FEATURES_QUERY_COMPLEXITY_LENGTH_WEIGHT=0.4
RTS_FEATURES_QUERY_COMPLEXITY_IDENTIFIER_WEIGHT=0.3
RTS_FEATURES_QUERY_COMPLEXITY_CLAUSE_WEIGHT=0.3

# query_complexity normalization constants (the value treated as
# "maximal" for each sub-signal before clamping to 1.0).
RTS_FEATURES_QUERY_COMPLEXITY_LENGTH_NORM=25
RTS_FEATURES_QUERY_COMPLEXITY_IDENTIFIER_NORM=5
RTS_FEATURES_QUERY_COMPLEXITY_CLAUSE_NORM=3

# If true, re-read each source file from disk to compute
# comment_coverage_ratio. If false, it is always 0.0.
RTS_FEATURES_ENABLE_COMMENT_COVERAGE=true
