# Copy this file to .env to override PythonParserPipeline defaults.
# Every variable is optional; all settings have sensible defaults
# (see evaluation/rts_builder/parser/config.py).

# Local directory under which per-repository repository_model.json cache
# entries are written, one subdirectory per repository_id.
RTS_PARSER_CACHE_ROOT=.rts_cache/parsed

# If true, always re-parse and rebuild, ignoring any cached
# repository_model.json for the requested (repository_id, commit_sha)
# even if one exists.
RTS_PARSER_FORCE_REPARSE=false

# Python source files larger than this many bytes are skipped during the walk.
RTS_PARSER_MAX_FILE_SIZE_BYTES=2000000

# Additional directory names to exclude from the walk, beyond the
# built-in defaults (.git, __pycache__, .venv, node_modules, etc.).
# JSON list syntax, e.g. ["fixtures", "vendor"].
RTS_PARSER_IGNORED_DIRECTORIES=[]

# If true, build the call graph via name-based call-site resolution.
RTS_PARSER_ENABLE_CALL_GRAPH=true

# If true, build the class inheritance graph via name-based base-class resolution.
RTS_PARSER_ENABLE_INHERITANCE_GRAPH=true
