# Copy this file to .env to override RetrievalExecutor defaults. Every
# variable is optional; all settings have sensible defaults
# (see evaluation/rts_builder/retrieval_executor/config.py).

# Maximum files returned by each strategy.
RTS_RETRIEVAL_TOP_K=10

# Characters-per-token ratio for context_token_count.
RTS_RETRIEVAL_CHARS_PER_TOKEN_ESTIMATE=4.0

# --- Lexical Retrieval ---
RTS_RETRIEVAL_BM25_K1=1.5
RTS_RETRIEVAL_BM25_B=0.75
# lexical_*_weight fields must sum to 1.0.
RTS_RETRIEVAL_LEXICAL_BM25_WEIGHT=0.5
RTS_RETRIEVAL_LEXICAL_IDENTIFIER_WEIGHT=0.3
RTS_RETRIEVAL_LEXICAL_KEYWORD_OVERLAP_WEIGHT=0.2

# --- Dense Retrieval ---
RTS_RETRIEVAL_EMBEDDING_DIMENSIONS=128

# --- Graph Retrieval ---
RTS_RETRIEVAL_MAX_GRAPH_HOPS=2

# --- Hybrid Retrieval ---
# hybrid_*_weight fields must sum to 1.0.
RTS_RETRIEVAL_HYBRID_LEXICAL_WEIGHT=0.3333333333333333
RTS_RETRIEVAL_HYBRID_DENSE_WEIGHT=0.3333333333333333
RTS_RETRIEVAL_HYBRID_GRAPH_WEIGHT=0.3333333333333333

# --- Latency budget scaling ---
RTS_RETRIEVAL_LARGE_REPOSITORY_TOP_K_CAP=5
