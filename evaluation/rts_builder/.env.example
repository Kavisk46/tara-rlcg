# Copy this file to .env (within evaluation/rts_builder/, or wherever the
# process is run from) to override RepositoryLoader defaults. Every
# variable is optional; all settings have sensible defaults
# (see evaluation/rts_builder/config.py).

# Local directory under which repositories are cloned, one subdirectory
# per repository_id.
RTS_CLONE_ROOT=.rts_cache/repositories

# Maximum time (seconds) allowed for a single git clone before it is
# aborted. Enforced on Linux/macOS; unavailable on Windows due to a
# GitPython/Windows platform limitation (see README.md "Potential
# Failure Modes").
RTS_CLONE_TIMEOUT_SECONDS=300

# Additional directory names to exclude from file/directory counts,
# beyond the built-in defaults (.git, node_modules, __pycache__, venv,
# dist, build, etc.). JSON list syntax, e.g. ["fixtures", "vendor"].
RTS_IGNORED_DIRECTORIES=[]

# File count above which a warning is logged (may indicate a
# misconfigured clone, e.g. an unignored build-artifact directory).
RTS_MAX_FILE_COUNT_WARNING_THRESHOLD=100000

# Maximum time (seconds) to wait to acquire a repository's lock before
# raising RepositoryLockError. Held for the full duration of a single
# load_repository() call, so this should comfortably exceed the slowest
# expected clone/fetch, especially under concurrent workers.
RTS_LOCK_TIMEOUT_SECONDS=600

# If true, recursively initialize and update git submodules so their
# content is included in file/directory counts and language detection.
# If false (default), submodule directories are left uninitialized,
# excluded from all counts, and recorded on Repository.submodules
# instead -- so loading a repository never implicitly clones additional,
# unvetted third-party repositories.
RTS_INITIALIZE_SUBMODULES=false
