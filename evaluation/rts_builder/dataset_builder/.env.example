# Copy this file to .env to override DatasetGenerator defaults. Every
# variable is optional; all settings have sensible defaults
# (see evaluation/rts_builder/dataset_builder/config.py).

# Directory every export file/checkpoint/statistics file is written under.
RTS_DATASET_OUTPUT_DIR=.rts_cache/dataset

RTS_DATASET_LONG_FORMAT_JSONL_FILENAME=rts_long.jsonl
RTS_DATASET_LONG_FORMAT_CSV_FILENAME=rts_long.csv
# A directory, not a file -- one part-<uuid>.parquet per run. See README.md.
RTS_DATASET_LONG_FORMAT_PARQUET_DIRNAME=rts_long.parquet
RTS_DATASET_GROUPED_JSONL_FILENAME=rts_grouped.jsonl
RTS_DATASET_CHECKPOINT_FILENAME=checkpoint.jsonl
RTS_DATASET_STATISTICS_FILENAME=dataset_statistics.json

RTS_DATASET_ENABLE_JSONL_EXPORT=true
RTS_DATASET_ENABLE_CSV_EXPORT=true
RTS_DATASET_ENABLE_PARQUET_EXPORT=true
RTS_DATASET_ENABLE_GROUPED_EXPORT=true

# Rows buffered before being flushed as one Parquet row group.
RTS_DATASET_PARQUET_BATCH_SIZE=256
